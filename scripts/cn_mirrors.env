# 国内镜像统一配置。用法：
#   set -a; source scripts/cn_mirrors.env; set +a
# 或在 Docker / 部署脚本中 export 同名变量。

# pip：清华 PyPI
export PIP_INDEX_URL="${PIP_INDEX_URL:-https://pypi.tuna.tsinghua.edu.cn/simple}"
export PIP_TRUSTED_HOST="${PIP_TRUSTED_HOST:-pypi.tuna.tsinghua.edu.cn}"
export PIP_DEFAULT_TIMEOUT="${PIP_DEFAULT_TIMEOUT:-120}"

# PyTorch CUDA wheel（官方源在国内慢；阿里云同步较全）
export PYTORCH_INDEX_URL="${PYTORCH_INDEX_URL:-https://mirrors.aliyun.com/pytorch-wheels/cu124}"

# npm：npmmirror
export NPM_CONFIG_REGISTRY="${NPM_CONFIG_REGISTRY:-https://registry.npmmirror.com}"

# Hugging Face：优先走 hf-mirror（无魔搭镜像时的兜底）
export HF_ENDPOINT="${HF_ENDPOINT:-https://hf-mirror.com}"

# PaddleX / PaddleOCR 模型源：魔搭
export PADDLE_PDX_MODEL_SOURCE="${PADDLE_PDX_MODEL_SOURCE:-modelscope}"
export PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK="${PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK:-True}"

# vLLM 可选走魔搭（PaddleOCR-VL 等）
export VLLM_USE_MODELSCOPE="${VLLM_USE_MODELSCOPE:-true}"

# Docker Hub 加速（写到 daemon.json 的 registry-mirrors）
# 配置脚本：sudo bash scripts/configure_docker_mirror.sh
# 说明：阿里云个人加速器在部分网络会 403，默认把 daoCloud 放前面作主源，
# 仍保留阿里云加速器作为候选。
export DOCKER_REGISTRY_MIRROR="${DOCKER_REGISTRY_MIRROR:-https://docker.m.daocloud.io}"
export DOCKER_REGISTRY_MIRRORS="${DOCKER_REGISTRY_MIRRORS:-https://docker.m.daocloud.io,https://mirror.ccs.tencentyun.com,https://i1r362m9.mirror.aliyuncs.com}"
