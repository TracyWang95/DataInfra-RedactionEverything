# ============================================================
# DataInfra-RedactionEverything local/dev environment template
# Copy this file to .env and adjust values as needed.
# ============================================================

# ---------- Basics ----------
DEBUG=false
# APP_NAME=DataShield Redaction Infrastructure
# BACKEND_ENV_FILE=.env

# ---------- Authentication ----------
AUTH_ENABLED=true
# JWT_SECRET_KEY=
# JWT_EXPIRE_MINUTES=1440

# ---------- Directories ----------
# 仅 Docker 需要（compose 已内置同值）。本地 Windows 开发不要取消注释，
# 否则 /app/data 会被解析成盘根目录；不设置时后端使用项目内默认目录。
# DATA_DIR=/app/data
# UPLOAD_DIR=/app/uploads
# OUTPUT_DIR=/app/outputs

# ---------- File limits ----------
# MAX_FILE_SIZE=52428800

# ---------- Service endpoints ----------
# Docker internal network — 仅 Docker 需要（compose 已内置同值），
# 本地开发保持注释（npm run dev 会自动指向 WSL 服务地址）:
# OCR_BASE_URL=http://ocr:8082
# HAS_TEXT_VLLM_BASE_URL=http://ner:8080/v1
# VISUAL_FEATURES_BASE_URL=http://visual-features:8090

# Host ports:
# OCR_PORT=8082
# NER_PORT=8080
# VISUAL_FEATURES_PORT=8090

# Local development without Docker:
# OCR_BASE_URL=http://127.0.0.1:8082
# HAS_TEXT_VLLM_BASE_URL=http://127.0.0.1:8080/v1
# VISUAL_FEATURES_BASE_URL=http://127.0.0.1:8090

# ---------- Local npm dev profile ----------
# npm run dev starts the frontend, backend, PaddleOCR-VL, PP-StructureV3,
# HaS Text, GLM-4.6V-Flash visual grounding, and optionally HaS-Image YOLO.
# The GLM adapter replaces the old LocateAnything service.

# 本地开发必填（npm run dev 启动时 required，缺少会直接报 config 错误）。
# 三个值都是 WSL 内的 Linux 路径，参见 README "WSL 模型服务环境准备":
# WSL venv that runs PP-StructureV3 / the OCR wrapper (scripts/ocr_server.py):
VENV_DIR=/home/YOUR_USER/.cache/datainfra-redaction/.venv
# WSL venv with vLLM installed (serves HaS Text, GLM vLLM, optional PaddleOCR-VL):
VLLM_VENV_DIR=/home/YOUR_USER/.cache/datainfra-redaction/.venv-vllm
# HaS Text HF (bf16) model directory, as a WSL path:
HAS_TEXT_HF_MODEL_PATH=/mnt/d/has_models/HaS_4.0_0.6B

# Windows project venv for the FastAPI backend (optional, default .venv):
# WINDOWS_VENV_DIR=.venv

# PaddleOCR-VL 1.6 via vLLM in WSL:
# OCR_VL_BACKEND=vllm-server
# OCR_VLLM_URL=http://127.0.0.1:8118/v1
# OCR_VL_API_MODEL_NAME=PaddleOCR-VL-1.6-0.9B
# --kv-cache-memory-bytes pins the KV size explicitly. Profiling-based sizing
# reads WSL/WDDM free-memory numbers that go wrong once several models are
# resident, which makes cold starts fail on whichever large engine loads last.
# VLLM_EXTRA_ARGS=--max-model-len 4096 --max-num-batched-tokens 1536 --gpu-memory-utilization 0.20 --kv-cache-memory-bytes 536870912 --no-enable-prefix-caching --mm-processor-cache-gb 0 --enforce-eager --attention-backend TRITON_ATTN --mm-encoder-attn-backend TORCH_SDPA

# HaS Text via vLLM in WSL (model path: see required HAS_TEXT_HF_MODEL_PATH above):
# HAS_TEXT_RUNTIME=vllm
# HAS_TEXT_MODEL_NAME=HaS_4.0_0.6B
# HAS_TEXT_VLLM_EXTRA_ARGS=--dtype bfloat16 --max-model-len 4096 --max-num-batched-tokens 4096 --gpu-memory-utilization 0.15 --no-enable-prefix-caching --enforce-eager --default-chat-template-kwargs {"enable_thinking":false}
# HAS_NER_CONTEXT_TOKENS=8192
# HAS_NER_MAX_TOKENS=8192

# GLM-4.6V-Flash visual grounding in WSL:
# GLM_VISUAL_ENABLED=1
# GLM_MODEL_PATH=/mnt/d/has_models/glm-fp8
# GLM_MODEL_NAME=glm-fp8
# GLM_BASE_URL=http://127.0.0.1:8120/v1
# GLM_VISUAL_PORT=8130
# GLM_VLLM_EXTRA_ARGS=--dtype bfloat16 --max-model-len 8192 --gpu-memory-utilization 0.45 --enforce-eager --default-chat-template-kwargs {"enable_thinking":false}

# HaS-Image YOLO11 small-object supplement (optional, default disabled):
# HAS_IMAGE_ENABLED=0
# HAS_IMAGE_PORT=8081
# HAS_IMAGE_WEIGHTS=/mnt/d/has_models/sensitive_seg_best.pt

# Visual feature signature supplements:
# VISUAL_FEATURES_SIGNATURE_OCR_FAST_PATH=true
# VISUAL_FEATURES_SIGNATURE_LOCAL_SUPPLEMENTS_ENABLED=true
# VISUAL_FEATURES_SIGNATURE_SKIP_WHEN_OCR_ANCHOR_FOUND=true
# OCR_MAX_IMAGE_SIDE=2048
# OCR_MAX_NEW_TOKENS=2048
# OCR_STRUCTURE_ENABLED=false
# OCR_STRUCTURE_WARMUP=0
# OCR_STRUCTURE_TEXT_PRECISION_ENABLED=false

# ---------- Timeouts ----------
# OCR_TIMEOUT=360
# HAS_TIMEOUT=120
# VISUAL_FEATURES_TIMEOUT=240

# ---------- PaddleOCR device ----------
# OCR_REQUIRE_GPU=false
# OCR_STRUCTURE_TEXT_PRECISION_ENABLED=true
# Enable GPU services with:
# docker compose --profile gpu up -d

# ---------- Concurrency ----------
# JOB_CONCURRENCY=3
# BATCH_RECOGNITION_PAGE_CONCURRENCY=1
# HAS_NER_MAX_PARALLEL_REQUESTS=1
# VISUAL_FEATURES_CONCURRENCY=1
# VISION_DUAL_PIPELINE_PARALLEL=false

# ---------- CORS ----------
# CORS_ORIGINS=["http://localhost:3000"]
# WARNING: do not use ["*"] in production.

# ---------- Optional security ----------
# VIRUS_SCAN_ENABLED=false

# ---------- Reverse proxy ----------
# Trusted proxy IPs / CIDRs (JSON list). X-Forwarded-For is only honoured when
# request.client.host matches one of these. Default: loopback (127.0.0.1/::1)
# + 172.16.0.0/12 (covers the docker compose bridge network). If your reverse
# proxy sits on a 10.x or 192.168.x network, configure it explicitly:
# TRUSTED_PROXIES=["127.0.0.1","::1","192.168.1.10"]

# ---------- Redaction ----------
# DEFAULT_REPLACEMENT_MODE=smart
