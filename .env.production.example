# ============================================================
# DataInfra-RedactionEverything production environment template
# Copy to .env and fill in all values before deployment.
# ============================================================

# ---------- Basics ----------
DEBUG=false
# BACKEND_ENV_FILE=.env.tenant-a

# ---------- Authentication ----------
AUTH_ENABLED=true
JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
# JWT_EXPIRE_MINUTES=1440

# ---------- CORS ----------
CORS_ORIGINS=["https://your-domain.com"]

# ---------- File security ----------
# VIRUS_SCAN_ENABLED=false
# MAX_FILE_SIZE=104857600

# ---------- Directories ----------
DATA_DIR=/app/data
UPLOAD_DIR=/app/uploads
OUTPUT_DIR=/app/outputs

# ---------- Microservice URLs ----------
OCR_BASE_URL=http://ocr:8082
HAS_TEXT_RUNTIME=vllm
HAS_TEXT_VLLM_BASE_URL=http://ner:8080/v1
HAS_TEXT_MODEL_NAME=HaS_Text_0209_0.6B
VISUAL_FEATURES_BASE_URL=http://visual-features:8090
# HAS_IMAGE_URL=http://has-image:8081

# ---------- Timeouts ----------
# OCR_TIMEOUT=360
# HAS_TIMEOUT=120
# VISUAL_FEATURES_TIMEOUT=240
# OCR_MAX_IMAGE_SIDE=2048
# OCR_MAX_NEW_TOKENS=2048
# HAS_NER_CONTEXT_TOKENS=8192
# HAS_NER_MAX_TOKENS=8192

# ---------- Logging ----------
LOG_JSON=true

# ---------- Reverse proxy ----------
# Trusted proxy IPs / CIDRs (JSON list). X-Forwarded-For is only honoured when
# request.client.host matches one of these. Default: loopback (127.0.0.1/::1)
# + 172.16.0.0/12 (covers the docker compose bridge network). If your reverse
# proxy sits on a 10.x or 192.168.x network, configure it explicitly here.
# TRUSTED_PROXIES=["10.0.0.1"]

# ---------- Structured DB connections (SSRF guard) ----------
# Optional allowlist for user-supplied database hosts on structured data
# connections (JSON list; exact hostnames or IP/CIDR entries). Unset = no
# restriction (default): users may connect to any reachable host.
# STRUCTURED_DB_HOST_ALLOWLIST=["db.internal","10.20.0.0/16"]

# ---------- GPU services ----------
OCR_REQUIRE_GPU=true
OCR_STRUCTURE_TEXT_PRECISION_ENABLED=true

# ---------- Multi-tenant concurrency ----------
JOB_CONCURRENCY=3
BATCH_RECOGNITION_PAGE_CONCURRENCY=1
HAS_NER_MAX_PARALLEL_REQUESTS=1
VISUAL_FEATURES_CONCURRENCY=1
VISION_DUAL_PIPELINE_PARALLEL=false

# ---------- Docker Compose ports ----------
# FRONTEND_PORT=3000
# BACKEND_PORT=8000
# OCR_PORT=8082
# NER_PORT=8080
# VISUAL_FEATURES_PORT=8090

# ---------- GLM Visual Grounding ----------
# GLM_BASE_URL=http://glm-vllm:8120/v1
# GLM_MODEL_NAME=glm-fp8
# VISUAL_FEATURES_SIGNATURE_OCR_FAST_PATH=true
# VISUAL_FEATURES_SIGNATURE_LOCAL_SUPPLEMENTS_ENABLED=true
# VISUAL_FEATURES_SIGNATURE_SKIP_WHEN_OCR_ANCHOR_FOUND=true
# OCR_STRUCTURE_ENABLED=false
# OCR_STRUCTURE_WARMUP=0
# OCR_STRUCTURE_TEXT_PRECISION_ENABLED=false
