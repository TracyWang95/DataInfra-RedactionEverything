# ============================================================
# DataInfra-RedactionEverything — Production Environment Template
# Copy to .env and fill in ALL values before deploying.
# ============================================================

# ---------- 基础 / Basics ----------
# MUST be false in production to disable verbose error output
DEBUG=false

# Compose backend env_file path. For tenant env files, either set this to the
# file name in each tenant env or pass BACKEND_ENV_FILE=.env.tenant-a at launch.
# BACKEND_ENV_FILE=.env.tenant-a

# ---------- 认证 / Authentication ----------
# MUST be true for any non-local deployment — unauthenticated access is a critical risk
AUTH_ENABLED=true

# Generate a strong secret: openssl rand -hex 32
# Do NOT leave blank in production — file-based auto-generation is not recommended
JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32

# Token expiry in minutes (default 1440 = 24h). Shorten for high-security environments.
# JWT_EXPIRE_MINUTES=1440

# ---------- CORS ----------
# MUST be set to your actual domain(s). Never use ["*"] or localhost in production.
# WARNING: If CORS_ORIGINS contains localhost while DEBUG=false, the backend will log
# a security warning at startup.
CORS_ORIGINS=["https://your-domain.com"]

# ---------- 文件安全 / File Security ----------
# Enable AES-256-GCM encryption for uploaded files containing PII / sensitive data
FILE_ENCRYPTION_ENABLED=true

# Enable ClamAV virus scanning (requires ClamAV daemon running)
# VIRUS_SCAN_ENABLED=false

# Maximum upload file size in bytes (default 50MB)
# MAX_FILE_SIZE=52428800

# ---------- 目录 / Directories (container paths, persisted via volumes) ----------
DATA_DIR=/app/data
UPLOAD_DIR=/app/uploads
OUTPUT_DIR=/app/outputs

# ---------- 微服务 / Microservice URLs (Docker internal network) ----------
OCR_BASE_URL=http://ocr:8082
HAS_LLAMACPP_BASE_URL=http://ner:8080/v1
HAS_IMAGE_BASE_URL=http://vision:8081

# ---------- 超时 / Timeouts (seconds) ----------
# OCR_TIMEOUT=360
# HAS_TIMEOUT=120
# HAS_IMAGE_TIMEOUT=120

# ---------- 日志 / Logging ----------
# JSON structured logs for production log aggregators (ELK, Datadog, etc.)
LOG_JSON=true

# ---------- 反向代理 / Reverse Proxy ----------
# If behind a load balancer or reverse proxy, list trusted proxy IPs so
# X-Forwarded-For / X-Real-IP headers are honoured for rate limiting and audit logs.
# TRUSTED_PROXY_IPS=["10.0.0.1"]

# ---------- GPU 服务 / GPU Services ----------
# Set to true to fail fast when OCR GPU is unavailable instead of slow CPU fallback
# OCR_REQUIRE_GPU=false
OCR_REQUIRE_GPU=true

# ---------- Multi-tenant concurrency ----------
# Instance-level tenant isolation: run one compose project per tenant with a
# separate .env file, compose project name, domain, JWT secret, and Docker
# volumes. Keep the sum of JOB_CONCURRENCY across tenants on the same GPU <= 3.
#
# Default for one company instance: JOB_CONCURRENCY=3
# Three tenants sharing one GPU: set JOB_CONCURRENCY=1 in each tenant env
JOB_CONCURRENCY=3

# Stable shared-GPU defaults. Raise only after measuring latency and VRAM.
BATCH_RECOGNITION_PAGE_CONCURRENCY=1
HAS_NER_MAX_PARALLEL_REQUESTS=1
VISION_DUAL_PIPELINE_PARALLEL=false

# ---------- Docker Compose ports ----------
# FRONTEND_PORT=3000
# BACKEND_PORT=8000
# OCR_PORT=8082
# NER_PORT=8080
# VISION_PORT=8081
