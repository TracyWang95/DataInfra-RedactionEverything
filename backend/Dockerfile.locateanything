FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    git libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-locateanything.txt .
RUN pip install torch torchvision --index-url https://download.pytorch.org/whl/cu124 \
    && pip install -r requirements-locateanything.txt

COPY scripts/locate_anything_eval.py .
COPY scripts/locate_anything_server.py .

RUN adduser --disabled-password --gecos '' appuser && \
    chown -R appuser:appuser /app
USER appuser

EXPOSE 8090

CMD ["python", "locate_anything_server.py", "--host", "0.0.0.0", "--port", "8090"]
