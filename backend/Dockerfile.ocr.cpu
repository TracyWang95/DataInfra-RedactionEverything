FROM python:3.11-slim

ENV PIP_NO_CACHE_DIR=1 \
    PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple \
    PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn \
    HF_ENDPOINT=https://hf-mirror.com \
    PADDLE_PDX_MODEL_SOURCE=modelscope \
    PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True \
    OCR_VL_ENABLED=0 \
    OCR_STRUCTURE_ENABLED=1 \
    OCR_ALLOW_CPU=1 \
    OCR_DEVICE=cpu

WORKDIR /app

RUN set -eux; \
    if [ -f /etc/apt/sources.list.d/debian.sources ]; then \
      sed -i 's|deb.debian.org|mirrors.tuna.tsinghua.edu.cn|g; s|security.debian.org|mirrors.tuna.tsinghua.edu.cn|g' \
        /etc/apt/sources.list.d/debian.sources; \
    elif [ -f /etc/apt/sources.list ]; then \
      sed -i 's|deb.debian.org|mirrors.tuna.tsinghua.edu.cn|g; s|security.debian.org|mirrors.tuna.tsinghua.edu.cn|g' \
        /etc/apt/sources.list; \
    fi; \
    apt-get update && apt-get install -y --no-install-recommends \
      libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-ocr-cpu.txt .
RUN pip install --no-cache-dir -r requirements-ocr-cpu.txt

COPY scripts/ocr_server.py .

RUN adduser --disabled-password --gecos '' appuser \
    && mkdir -p /home/appuser/.paddlex /home/appuser/.cache \
    && chown -R appuser:appuser /home/appuser
USER appuser

EXPOSE 8082

# python entry runs init_ocr()/warmup before serving
CMD ["python", "ocr_server.py"]
