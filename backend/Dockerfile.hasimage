FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# HaS-Image needs torch + ultralytics (YOLO11 runtime).
RUN pip install torch torchvision --index-url https://download.pytorch.org/whl/cu124 \
    && pip install ultralytics fastapi uvicorn pydantic Pillow

COPY scripts/has_image_server.py .
COPY app/core/has_image_categories.py /app/has_image_categories.py

RUN adduser --disabled-password --gecos '' appuser && \
    chown -R appuser:appuser /app
USER appuser

EXPOSE 8081

CMD ["python", "has_image_server.py"]
